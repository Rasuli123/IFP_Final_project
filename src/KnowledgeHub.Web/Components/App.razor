<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
<link rel="stylesheet" href="app.css" />
<link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <HeadOutlet @rendermode="Mode" />
</head>
<body>
<Routes @rendermode="Mode" />
<script src="@Assets["_framework/blazor.web.js"]">
</script>
<div id="blazor-error-ui" role="alert">The connection was interrupted. <a href="">Reload the page</a> to continue.</div>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;
    private IComponentRenderMode? Mode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
