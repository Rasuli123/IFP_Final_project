@typeparam TItem
@if (Items.Count == 0) {
<div class="empty-state">
<span class="empty-icon">▤</span>
<h3>@EmptyTitle</h3>
<p>@EmptyText</p>
</div> }
else {
<div class="table-wrap">
<table>
<thead>
<tr>@Header</tr>
</thead>
<tbody>@foreach (var item in Items) {
<tr>@Row(item)</tr> }
</tbody>
</table>
</div> }

@code {
    [Parameter]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public RenderFragment Header { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> Row { get; set; } = null!;

    [Parameter]
    public string EmptyTitle { get; set; } = "Nothing here yet";

    [Parameter]
    public string EmptyText { get; set; } = "New records will appear here.";
}
